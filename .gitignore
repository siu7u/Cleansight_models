# CleanSight model-set gitignore
#
# Keep source code, configs, registry metadata, model cards, and reports in git.
# Keep raw media, generated datasets, training outputs, local secrets, and large
# model binaries out of git. Version large weights with ModelScope or Git LFS.

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
*:Zone.Identifier
*.swp
*.swo
*~
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Python cache / tooling cache
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Local environments and secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Logs, temporary files, and local scratch output
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
.cache/

# ---------------------------------------------------------------------------
# Raw media and generated datasets
# ---------------------------------------------------------------------------
datasets/
**/raw/videos/
**/raw/media/
**/raw/downloads/
**/datasets/

# ---------------------------------------------------------------------------
# Feature stores and derived temporal datasets
# ---------------------------------------------------------------------------
**/data/Endo_Project/
**/data/raw/
**/data/processed/
**/data/features/
**/data/groundTruth/
**/data/ground_truth/
**/data/cache/
**/*.npy
**/*.npz

# ---------------------------------------------------------------------------
# Training outputs and experiment artifacts
# ---------------------------------------------------------------------------
**/checkpoints/
**/runs/
**/outputs/
**/results/
**/experiments/
**/wandb/
**/mlruns/

# YOLO local assets that are not registry metadata.
legacy/yolo-detection/base_weights/
legacy/yolo-detection/experiments/
legacy/yolo-detection/pipeline/raw/
legacy/yolo-detection/pipeline/runs/
legacy/yolo-detection/pipeline/versioned_weights/
legacy/yolo-detection/pipeline/yolo*.pt
legacy/temporal-*/checkpoints/
legacy/temporal-*/experiments/
legacy/temporal-*/weights/
legacy/**/__pycache__/

# Keep benchmark scripts and markdown summaries, but ignore bulky benchmark
# outputs unless explicitly promoted into reports.
benchmark/**/outputs/
benchmark/**/predictions/
benchmark/**/visualizations/
benchmark/**/latest/
benchmark/**/reports/
benchmark/**/*.mp4
benchmark/**/*.avi
benchmark/**/*.mov

# ---------------------------------------------------------------------------
# Large model binaries
# ---------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.trt
*.torchscript
*.safetensors

# Registry metadata should stay visible even though model binaries are ignored.
!/registry/
!/registry/**/
!/registry/**/*.md
!/registry/**/*.json
!/registry/**/*.yaml
!/registry/**/*.yml

# 迁移前已经受 Git 跟踪的四个时序权重继续保留，便于复核历史结果。
# 新 checkpoint 不得再增加例外，应由 pin.yaml 引用外部对象存储。
!/registry/temporal/gru-v1/gru-final-20260704-150629.pt
!/registry/temporal/gru-v1/gru-final-20260704-155233.pt
!/registry/temporal/causal-tcn-v1/tcn-final-20260704-160652.pt
!/registry/temporal/causal-transformer-v1/transformer-final-20260704-161653.pt

# ---------------------------------------------------------------------------
# Legacy imported source snapshots
# ---------------------------------------------------------------------------
CausalModel-master/
cleansight-yolo-pipeline-main/
cleansight-ActionMixed/

# 本地数据挂载；catalog 只登记稳定相对路径，数据本体和绝对符号链接不入 Git。
!/datasets/
/datasets/*
!/datasets/README.md
cleansight-ActionSequence/
references
modelscope_upload
.codex
raw
.cache_ggshield
# 外部 checkpoint 目录采用白名单：只允许可复现 YAML 配置进入 Git。
# 权重、评测报告、timeline 和其他本地产物无论扩展名为何都保持忽略。
external_checkpoints/**
!external_checkpoints/**/
!external_checkpoints/**/*.yaml
!external_checkpoints/**/*.yml
# ---------------------------------------------------------------------------
# Framework experiment CONFIGS are the 实验配置层 (source/config), keep tracked
# even though **/experiments/ above ignores training-output experiment dirs.
# ---------------------------------------------------------------------------
!framework/experiments/
!framework/experiments/**


# Added by ggshield
.cache_ggshield
